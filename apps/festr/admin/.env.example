# Postgres. On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (used for migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/festr

# Single admin login. Generate the hash with `pnpm hash-password`.
# In .env files escape each $ as \$ (the script prints both forms); paste the raw hash into Vercel.
ADMIN_EMAIL=calumpeterwebb@icloud.com
ADMIN_PASSWORD_HASH=

# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=

# Optional: enables Import from image through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# AI_VISION_MODEL=google/gemini-2.5-flash
